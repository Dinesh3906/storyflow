# ==============================================================================
# StoryFlow Production Environment Configuration Template
# ==============================================================================

# Database (PostgreSQL with asyncpg for production; SQLite with aiosqlite supported for local tests)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/storyflow
# SQLite fallback example:
# DATABASE_URL=sqlite+aiosqlite:///./storyflow.db

# Redis (Session state, pub/sub, caching, job queue)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
AUTH_SECRET=generate-a-strong-random-secret-key-min-32-chars-for-production
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Speech-to-Text Provider (Deepgram Nova-3 Streaming — OPTIONAL, replaced by local Whisper)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# AI Transformation Engine (Google Gemini — OPTIONAL, replaced by Groq)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq AI Engine (PRIMARY — ultra-fast LPU inference, free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=default

# Local Speech-to-Text (faster-whisper — runs offline, no API key needed)
# Model sizes: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# S3 / MinIO Object Storage (PDFs, exports, audio recordings)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=storyflow-documents
STORAGE_REGION=us-east-1

# Services Network Ports
REALTIME_PORT=8080
API_PORT=8000
WEB_PORT=3000

# Client-side Public Endpoints (Browser WebSocket & API)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
